# Groq generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/

# Retrieval
RETRIEVAL_MODE=hybrid             # hybrid | bm25
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
MIN_RELEVANCE_SCORE=0.12          # normalized hybrid score; tune with eval questions
CHUNK_SIZE=1100
CHUNK_OVERLAP=150

# Behaviour
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Secret Key
JWT_SECRET_KEY=
JWT_ALGORITHM=
